# ==============================================================================
# DIZCO Luxury Fashion E-Commerce — Client Environment Configuration
# ==============================================================================
# Instructions:
# 1. In development, Vite automatically proxies /api to http://127.0.0.1:8000.
# 2. In production, if backend is on a separate domain (e.g., Render/Railway):
#    Set VITE_API_URL=https://api.yourdomain.com/api
#    Or leave blank to use same-origin relative path /api (if using reverse proxy / single domain).
# ==============================================================================

# Backend API base URL
VITE_API_URL=/api
