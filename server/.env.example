# ==============================================================================
# DIZCO Luxury Fashion E-Commerce — Server Environment Configuration
# ==============================================================================
# Instructions:
# 1. Copy this file to .env:  cp .env.example .env
# 2. In production, set ENVIRONMENT=production and provide a strong SECRET_KEY.
# 3. NEVER commit the actual .env file containing real secrets.
# ==============================================================================

# ─── Environment & Security ───────────────────────────────────────────────────
# Options: "development" | "production" | "testing"
ENVIRONMENT=development

# Required in production: minimum 32 random characters (e.g. openssl rand -hex 32)
SECRET_KEY=dizco-dev-jwt-secret-not-for-production-use-2026

# ─── Database ─────────────────────────────────────────────────────────────────
# Development SQLite: sqlite:///./dizco.db
# Production PostgreSQL: postgresql://user:password@hostname:5432/dizco_prod
DATABASE_URL=sqlite:///./dizco.db

# ─── CORS & Frontend URLs ─────────────────────────────────────────────────────
# Allowed origins for CORS (comma-separated list for custom domains)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Base URL of frontend application (used for transactional email links)
FRONTEND_BASE_URL=http://localhost:5173

# ─── Razorpay Payment Gateway ─────────────────────────────────────────────────
# Test credentials format: rzp_test_... / Live credentials format: rzp_live_...
RAZORPAY_KEY_ID=rzp_test_dizco2026key
RAZORPAY_KEY_SECRET=dizco_test_secret_998877
RAZORPAY_WEBHOOK_SECRET=dizco_webhook_secret_12345

# ─── Cloudinary Media Storage ─────────────────────────────────────────────────
# Leave blank to fall back to local disk storage (/uploads) in development
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── SMTP Transactional Email ─────────────────────────────────────────────────
# Leave blank to skip email sending safely in local development
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=orders@dizco.com
SMTP_FROM_NAME=DIZCO
SMTP_USE_TLS=true
